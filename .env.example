# App listens on this port (local default 8080; Amvera usually 80).
PORT=8080

# Postgres pool user (wide rights: u_admin / clinic_app / postgres).
# Local example uses port 5433 — change if needed.
DATABASE_URL=postgres://u_admin:ClinicDemo1!@127.0.0.1:5433/clinic_db?sslmode=disable

# Secret for signing session cookies (min 16 chars).
SESSION_SECRET=dev-session-secret-change-me

# Set true/1 on Amvera HTTPS so session cookie is Secure.
# APP_ENV=production
# SECURE_COOKIE=true
